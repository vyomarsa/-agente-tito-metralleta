# Copia este archivo a .env.local y pon tu key real.
MASSIVE_API_KEY=tu_api_key_de_massive
MASSIVE_MAX_PAGES=40

# Cookie de sesión de app.marketsnack.com (para el sub-agente Time & Sales).
# DevTools → Network → request a /api/flow_feed → copia el header "Cookie" completo.
MARKETSNACK_COOKIE=

# --- Tastytrade (IV Rank / IV percentile reales, cuarta fuente de datos) ---
# OAuth2 "personal grant": NO hay redirect. Genera el refresh_token en el portal:
#   OAuth Applications → Manage → Create Grant  (el refresh_token no caduca).
# El client_secret sale al crear la OAuth Application.
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
# sandbox (api.cert.tastyworks.com, datos de mercado limitados) o production.
TASTYTRADE_ENV=sandbox
